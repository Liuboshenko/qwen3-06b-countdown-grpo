# Виртуальное окружение
venv3.12/
.venv/
venv/

# Кэши Python и Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Тяжёлые артефакты обучения (чекпойнты с состоянием оптимизатора)
checkpoints/

# LoRA-адаптеры хранятся на Hugging Face (liuboshenko/qwen3-0.6b-countdown-grpo-lora),
# локальную папку скачивает ноутбук countdown_tests.ipynb
adapters/

# Кэш моделей HuggingFace, если окажется внутри проекта
.cache/
hf_cache/

# Логи фоновых запусков
logs/*.log
logs/*.pid
nohup.out

# Системные и редакторские файлы
.DS_Store
.vscode/
.idea/
*.swp
